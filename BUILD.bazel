load("@rules_cc//cc:defs.bzl", "cc_test","cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake", "make", "configure_make")

# Auto-detected gfortran linker flags (includes -L<path> on macOS Homebrew).
# Only used on Linux; macOS uses Accelerate instead (see below).
load("@gfortran_config//:defs.bzl", "GFORTRAN_LINKOPTS")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Platform config_settings used by select() below.
# ---------------------------------------------------------------------------

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

# ---------------------------------------------------------------------------
# Windows support (MSYS2 / MinGW-w64 toolchain, see doc/Installation.md)
# ---------------------------------------------------------------------------
# The Linux/macOS targets below are unchanged.  Where a dependency needs a
# different build recipe on Windows (autotools / make are not usable there), a
# separate "*_cmake" target is provided and the consumers pick it with select().
#
# NOT_WINDOWS marks a target as incompatible with Windows, so that
# `bazel build //...` simply skips it there instead of failing.
NOT_WINDOWS = select({
    "//:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Bazel's MinGW toolchain passes CMake extension-less compiler paths
# (".../mingw64/bin/gcc"), which CMake rejects on Windows ("is not a full path
# to an existing compiler tool").  rules_foreign_cc lets `env` CC/CXX override
# the toolchain's compilers; plain names are resolved through PATH.
WINDOWS_CMAKE_ENV = select({
    "//:windows": {
        "CC": "gcc",
        "CXX": "g++",
    },
    "//conditions:default": {},
})

# ---------------------------------------------------------------------------
# macOS Accelerate framework
# ---------------------------------------------------------------------------
# On macOS we use Apple's built-in Accelerate framework instead of OpenBLAS.
# Accelerate provides both BLAS and LAPACK, requires zero build steps, and is
# hardware-optimised for Apple Silicon (AMX) – giving better performance than
# a generic OpenBLAS build. Armadillo (with -DARMA_DONT_USE_WRAPPER) and
# SuperLU both resolve their BLAS/LAPACK symbols against it transparently.
cc_library(
    name = "macos_accelerate",
    linkopts = ["-framework Accelerate"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# pcre
# ---------------------------------------------------------------------------

cmake(
    name = "pcre",
    cache_entries = {
        "CMAKE_C_FLAGS": "-fPIC",
    },
    lib_source = "@pcre//:all_srcs",
    out_static_libs = ["libpcre.a"],
    # Not used by the application; not ported to Windows.
    target_compatible_with = NOT_WINDOWS,
)

# ---------------------------------------------------------------------------
# OpenBLAS  (Linux only – macOS uses :macos_accelerate instead)
# ---------------------------------------------------------------------------
# Each full make will take about 10 minutes to run.
make(
    name = "openblas_lib",
    lib_source = "@openblas//:all_srcs",
    out_static_libs = ["libopenblas.a"],
    build_data = [
        "@openblas//:README.md",
    ],
    out_data_dirs = ["share"],
    # No extra args needed on Linux (the verified working platform).
    args = [],
    # macOS uses :macos_accelerate instead; mark incompatible so
    # `bazel build //...` skips this target on non-Linux platforms.
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "openblas_lib_bazel",
    srcs = [],
    visibility = ["//visibility:public"],
    deps = [
        ":openblas_lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# OpenBLAS on Windows: built with CMake (the `make` recipe above needs a POSIX
# build environment and is Linux-only).
#
# C_LAPACK=ON builds LAPACK from the bundled C translation, so no Fortran
# compiler (and no libgfortran at link time) is needed on Windows.
# BUILD_TESTING=OFF avoids building the LAPACK test-suite (default ON).
cmake(
    name = "openblas_lib_cmake",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_STATIC_LIBS": "ON",
        "BUILD_TESTING": "OFF",
        "C_LAPACK": "ON",
        "NOFORTRAN": "1",
    },
    lib_source = "@openblas//:all_srcs",
    out_static_libs = ["libopenblas.a"],
    env = WINDOWS_CMAKE_ENV,
    target_compatible_with = ["@platforms//os:windows"],
)

# Bridge to a plain cc_library so that dependants see OpenBLAS under the flat
# $EXT_BUILD_DEPS/lib directory, exactly like :openblas_lib_bazel on Linux.
cc_library(
    name = "openblas_lib_cmake_bazel",
    srcs = [],
    deps = [
        ":openblas_lib_cmake",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

# ---------------------------------------------------------------------------
# SuperLU
# ---------------------------------------------------------------------------
# There may be a bad symlinked header and the workaround is at:
# https://github.com/bazelbuild/rules_foreign_cc/issues/1129#issuecomment-1863628259
#
# macOS: SuperLU is pointed at Accelerate instead of OpenBLAS.
#        "-framework Accelerate" is passed as the BLAS path because CMake's
#        FindBLAS will accept it as a linker flag when given as a full path-
#        style argument.  The deps list is empty because Accelerate is a
#        system framework and needs no file dependency.
cmake(
    name = "superlu_lib",
    cache_entries = select({
        "//:macos": {
            "TPL_BLAS_LIBRARIES": "-framework Accelerate",
        },
        "//:windows": {
            # Same flat layout as Linux, via :openblas_lib_cmake_bazel.
            "TPL_BLAS_LIBRARIES": "$EXT_BUILD_DEPS/lib/libopenblas.a",
            # SuperLU builds its examples/tests by default; they are not needed
            # and only add link-time failure modes.
            "enable_examples": "OFF",
            "enable_tests": "OFF",
        },
        "//conditions:default": {
            # deps ":openblas_lib_bazel" will be copied to "$EXT_BUILD_DEPS"
            # The directory structure of ":openblas_lib_bazel" are retained,
            # usually libraries are under /lib and headers are under /include
            "TPL_BLAS_LIBRARIES": "$EXT_BUILD_DEPS/lib/libopenblas.a",
        },
    }),
    lib_source = "@superlu//:all_srcs",
    out_static_libs = ["libsuperlu.a"],
    env = WINDOWS_CMAKE_ENV,
    deps = select({
        "//:macos": [],
        "//:windows": [":openblas_lib_cmake_bazel"],
        "//conditions:default": [
            # cannot directly use ":openblas_lib",
            # need bridged through a `cc_library` containing ":openblas_lib"
            ":openblas_lib_bazel",
        ],
    }),
    linkopts = select({
        "//:macos": ["-framework Accelerate"],
        # OpenBLAS on Windows uses native threads; no -lpthread needed.
        "//:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
)

# ---------------------------------------------------------------------------
# Armadillo
# ---------------------------------------------------------------------------
# macOS: link against Accelerate; no Fortran runtime needed.
# Linux: link against OpenBLAS + gfortran runtime (existing behaviour).
cmake(
    name = "armadillo_lib",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
    },
    lib_source = "@armadillo//:all_srcs",
    out_static_libs = ["libarmadillo.a"],
    env = WINDOWS_CMAKE_ENV,
    deps = select({
        "//:macos": [],
        "//:windows": [":openblas_lib_cmake_bazel"],
        "//conditions:default": [":openblas_lib_bazel"],
    }),
    copts =[
        "-DARMA_DONT_USE_WRAPPER"
    ],
    linkopts = select({
        # Accelerate provides both BLAS and LAPACK on macOS.
        "//:macos": ["-framework Accelerate"],
        # Windows: OpenBLAS is built with C_LAPACK, so no Fortran runtime.
        "//:windows": [],
        # GFORTRAN_LINKOPTS is generated by //tools:gfortran_detect.bzl.
        # On Linux it is typically just ["-lgfortran"].
        "//conditions:default": GFORTRAN_LINKOPTS,
    }),
)

# ---------------------------------------------------------------------------
# HDF5 dependencies (zlib + libaec/szlib)
# ---------------------------------------------------------------------------

cc_library(
    name = "hdf5_deps_lib",
    deps = [
        ":z_lib",
        ":libaec",
    ],
)

#
configure_make(
    name = "hdf5_lib",
    configure_in_place = True,
    configure_options = [
        "--with-zlib=z_lib/include,$EXT_BUILD_DEPS/z_lib/lib",
    ] + select({
        # macOS: build WITHOUT szip (libaec).
        #
        # When HDF5 is built with szip, libhdf5.a contains the szip filter
        # object files which reference libaec symbols.  On macOS, Bazel adds
        # -Wl,-dead_strip to LDFLAGS, which causes the linker to evaluate ALL
        # archive members (before stripping unreachable ones).  This pulls the
        # szip code into the libmatio configure AC_CHECK_LIB(hdf5) link test,
        # where -laec is not on the link line → the test fails → libmatio is
        # compiled without HDF5 support → Mat_Open returns NULL for v7.3 files.
        #
        # MATLAB v7.3 files use DEFLATE (gzip) compression, not szip, so
        # omitting szip from the macOS HDF5 build has no practical impact.
        #
        # --disable-shared / --enable-static: prevents Apple libtool path.
        "//:macos": [
            "--without-szlib",
            "--disable-shared",
            "--enable-static",
        ],
        # Linux: keep szip support (no -dead_strip, so the link test works fine)
        "//conditions:default": [
            "--with-szlib=libaec/include,$EXT_BUILD_DEPS/libaec/lib",
        ],
    }),
    # macOS: rules_foreign_cc injects AR=/usr/bin/libtool from Bazel's toolchain.
    # HDF5's configure uses AR to generate its libtool wrapper script, so it
    # must see the real ar(1) here or the wrapper will call Apple libtool with
    # GNU-style flags and fail with "no output file specified".
    env = select({
        "//:macos": {
            "AR": "/usr/bin/ar",
            "RANLIB": "/usr/bin/ranlib",
        },
        "//conditions:default": {},
    }),
    lib_source = "@hdf5//:all_srcs",
    deps = [
        ":hdf5_deps_lib",
    ],
    out_static_libs = ["libhdf5.a"],
    linkopts = ["-lpthread"],
    includes = [
        "z_lib/include",
        "libaec/include",
    ],
    # autotools build; Windows uses :hdf5_lib_cmake below.
    target_compatible_with = NOT_WINDOWS,
)

# HDF5 on Windows: CMake build, without szip (same trade-off as macOS above:
# MATLAB v7.3 files use DEFLATE).
cmake(
    name = "hdf5_lib_cmake",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_STATIC_LIBS": "ON",
        # Defaults are ON; we only need the C library.
        "BUILD_TESTING": "OFF",
        "HDF5_BUILD_EXAMPLES": "OFF",
        "HDF5_BUILD_TOOLS": "OFF",
        "HDF5_BUILD_HL_LIB": "OFF",
        "HDF5_ENABLE_Z_LIB_SUPPORT": "ON",
        "HDF5_ENABLE_SZIP_SUPPORT": "OFF",
        # Foreign-cc dependencies are installed under $EXT_BUILD_DEPS/<target>/
        # (not merged into $EXT_BUILD_DEPS/lib), so point FindZLIB at it.
        "ZLIB_ROOT": "$EXT_BUILD_DEPS/z_lib",
        # zlib's CMake build also produces a shared import library on MinGW;
        # make sure the static one is picked.
        "ZLIB_USE_STATIC_LIBS": "ON",
    },
    lib_source = "@hdf5//:all_srcs",
    out_static_libs = ["libhdf5.a"],
    deps = [":z_lib"],
    env = WINDOWS_CMAKE_ENV,
    # HDF5 builds as -std=gnu99 and uses vasprintf(), which mingw-w64's stdio.h
    # only declares under _GNU_SOURCE (HDF5's CMake adds it on Linux, not on
    # MinGW); GCC 14+ rejects the resulting implicit declaration.
    copts = ["-D_GNU_SOURCE"],
    target_compatible_with = ["@platforms//os:windows"],
)

# ---------------------------------------------------------------------------
# zlib
# ---------------------------------------------------------------------------

cmake(
    name = "z_lib",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
    },
    lib_source = "@zlib//:all_srcs",
    out_static_libs = select({
        # zlib's CMake build only names the static library "libz.a" on UNIX;
        # on MinGW it is "libzlibstatic.a".
        "//:windows": ["libzlibstatic.a"],
        "//conditions:default": ["libz.a"],
    }),
    copts = ["-fPIC"], # this is necessary otherwise will cause hdf5 build to complain
    env = WINDOWS_CMAKE_ENV,
)

# ---------------------------------------------------------------------------
# libaec (szlib)
# ---------------------------------------------------------------------------

cmake(
    name = "libaec",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
    },
    lib_source = "@libaec//:all_srcs",
    out_static_libs = [
        "libaec.a",
        "libsz.a",
        ],
    # Only needed by the autotools HDF5 build; Windows builds HDF5 without szip.
    target_compatible_with = NOT_WINDOWS,
)

# ---------------------------------------------------------------------------
# libmatio
# ---------------------------------------------------------------------------

#
configure_make(
    name = "libmatio_lib",
    configure_in_place = True,
    configure_options = [
        "--enable-mat73=yes",
        "--enable-extended-sparse=yes",
        "--with-hdf5=\"$EXT_BUILD_DEPS/hdf5_lib/lib\"",
        "--with-zlib=\"$EXT_BUILD_DEPS/z_lib/lib\"",
        "--with-default-file-ver=7.3",
    ] + select({
        # --disable-shared / --enable-static: prevents Apple libtool path.
        # No LIBS= or LDFLAGS= overrides needed: HDF5 is built without szip on
        # macOS, so libhdf5.a has no libaec symbol references and
        # AC_CHECK_LIB(hdf5, H5open) succeeds with just -lhdf5 -lz.
        "//:macos": ["--disable-shared", "--enable-static"],
        "//conditions:default": [],
    }),
    # Same AR/RANLIB override as hdf5_lib — prevents Apple libtool from being
    # used in place of ar(1) when the configure-generated libtool wrapper runs.
    env = select({
        "//:macos": {
            "AR": "/usr/bin/ar",
            "RANLIB": "/usr/bin/ranlib",
        },
        "//conditions:default": {},
    }),
    lib_source = "@libmatio//:all_srcs",
    deps = [
        ":hdf5_lib",
        ":z_lib",
    ] + select({
        # macOS: HDF5 built without szip → libaec not needed here.
        # Linux: HDF5 built with szip → libaec needed for transitive link.
        "//:macos": [],
        "//conditions:default": [":libaec"],
    }),
    out_static_libs = ["libmatio.a"],
    linkopts = ["-lpthread"],
    # autotools build; Windows uses :libmatio_lib_cmake below.
    target_compatible_with = NOT_WINDOWS,
)

# libmatio on Windows: CMake build.  Consumers select between this and
# :libmatio_lib with
#   select({"//:windows": ["//:libmatio_lib_cmake"],
#           "//conditions:default": ["//:libmatio_lib"]})
cmake(
    name = "libmatio_lib_cmake",
    cache_entries = {
        # matio ignores BUILD_SHARED_LIBS; MATIO_SHARED defaults to ON.
        "MATIO_SHARED": "OFF",
        "MATIO_WITH_HDF5": "ON",
        "MATIO_WITH_ZLIB": "ON",
        "MATIO_MAT73": "ON",
        "MATIO_EXTENDED_SPARSE": "ON",
        # Same as `--with-default-file-ver=7.3` in the autotools build.
        "MATIO_DEFAULT_FILE_VERSION": "7.3",
        # If libm is found, matio links "m c"; MinGW has no libc.a, so its own
        # matdump/test_mat tools fail to link ("cannot find -lc").  Presetting
        # the cached check result avoids that; MinGW provides the math
        # functions without -lm.
        "HAVE_LIBM": "OFF",
        # Foreign-cc dependencies live in $EXT_BUILD_DEPS/<target>/ .
        "HDF5_ROOT": "$EXT_BUILD_DEPS/hdf5_lib_cmake",
        "ZLIB_ROOT": "$EXT_BUILD_DEPS/z_lib",
        "ZLIB_USE_STATIC_LIBS": "ON",
    },
    lib_source = "@libmatio//:all_srcs",
    out_static_libs = ["libmatio.a"],
    deps = [
        ":hdf5_lib_cmake",
        ":z_lib",
    ],
    env = WINDOWS_CMAKE_ENV,
    target_compatible_with = ["@platforms//os:windows"],
)

# ---------------------------------------------------------------------------
# jsoncpp
# ---------------------------------------------------------------------------

cmake(
    name = "libjsoncpp",
    cache_entries = select({
        # Windows: skip jsoncpp's own test programs (not needed).
        "//:windows": {
            "BUILD_SHARED_LIBS": "OFF",
            "JSONCPP_WITH_TESTS": "OFF",
            "JSONCPP_WITH_POST_BUILD_UNITTEST": "OFF",
        },
        "//conditions:default": {
            "BUILD_SHARED_LIBS": "OFF",
        },
    }),
    lib_source = "@jsoncpp//:all_srcs",
    env = WINDOWS_CMAKE_ENV,
    out_static_libs = [
        "libjsoncpp.a",
        ],
)
